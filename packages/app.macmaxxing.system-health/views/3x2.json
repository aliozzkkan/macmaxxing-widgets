{
  "type": "vstack",
  "spacing": 8,
  "children": [
    {
      "type": "hstack",
      "spacing": 8,
      "children": [
        {
          "type": "text",
          "text": "{{state.summary}}",
          "style": "value"
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isOk",
          "then": {
            "type": "badge",
            "text": "{{state.thermal.label}}",
            "tone": "positive"
          }
        },
        {
          "type": "when",
          "condition": "state.isWarning",
          "then": {
            "type": "badge",
            "text": "{{state.thermal.label}}",
            "tone": "warning"
          }
        },
        {
          "type": "when",
          "condition": "state.isCritical",
          "then": {
            "type": "badge",
            "text": "{{state.thermal.label}}",
            "tone": "critical"
          }
        },
        {
          "type": "when",
          "condition": "state.isMeasuring",
          "then": {
            "type": "badge",
            "text": "{{t.monitoring}}",
            "tone": "neutral"
          }
        }
      ]
    },
    {
      "type": "hstack",
      "spacing": 12,
      "children": [
        {
          "type": "when",
          "condition": "state.settings.showCPU",
          "then": {
            "type": "ring",
            "label": "{{state.cpu.label}}",
            "percent": "{{state.cpu.value}}"
          }
        },
        {
          "type": "vstack",
          "spacing": 6,
          "children": [
            {
              "type": "when",
              "condition": "state.settings.showMemory",
              "then": {
                "type": "bar",
                "label": "{{state.memory.label}}",
                "percent": "{{state.memory.value}}"
              }
            },
            {
              "type": "when",
              "condition": "state.settings.showGPU",
              "then": {
                "type": "bar",
                "label": "{{state.gpu.label}}",
                "percent": "{{state.gpu.value}}"
              }
            },
            {
              "type": "when",
              "condition": "state.settings.showDisk",
              "then": {
                "type": "bar",
                "label": "{{state.disk.label}}",
                "percent": "{{state.disk.value}}"
              }
            }
          ]
        }
      ]
    }
  ]
}
