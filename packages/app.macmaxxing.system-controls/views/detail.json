{
  "type": "vstack",
  "spacing": 12,
  "children": [
    {
      "type": "hstack",
      "spacing": 8,
      "children": [
        {
          "type": "text",
          "text": "{{t.volume}}",
          "style": "caption"
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isMuted",
          "then": {
            "type": "badge",
            "text": "{{t.muted}}",
            "tone": "warning"
          }
        }
      ]
    },
    {
      "type": "value",
      "label": "{{t.volume}}",
      "value": "{{state.volumeText}}"
    },
    {
      "type": "slider",
      "key": "volume",
      "min": 0,
      "max": 100,
      "step": 5,
      "action": "setVolume"
    },
    {
      "type": "hstack",
      "spacing": 6,
      "children": [
        {
          "type": "when",
          "condition": "state.isMuted",
          "then": {
            "type": "button",
            "title": "{{t.unmute}}",
            "action": "toggleMute",
            "symbol": "speaker.wave.2"
          }
        },
        {
          "type": "when",
          "condition": "state.notMuted",
          "then": {
            "type": "button",
            "title": "{{t.mute}}",
            "action": "toggleMute",
            "symbol": "speaker.slash"
          }
        },
        {
          "type": "button",
          "title": "{{t.down}}",
          "action": "volumeDown",
          "symbol": "speaker.wave.1"
        },
        {
          "type": "button",
          "title": "{{t.up}}",
          "action": "volumeUp",
          "symbol": "speaker.wave.3"
        }
      ]
    },
    {
      "type": "hstack",
      "spacing": 6,
      "children": [
        {
          "type": "button",
          "title": "{{t.sleep}}",
          "action": "displaySleep",
          "symbol": "display"
        },
        {
          "type": "button",
          "title": "{{t.sound}}",
          "action": "openSound",
          "symbol": "gearshape"
        }
      ]
    }
  ]
}
