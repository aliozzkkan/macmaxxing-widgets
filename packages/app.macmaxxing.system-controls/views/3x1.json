{
  "type": "hstack",
  "spacing": 8,
  "children": [
    {
      "type": "value",
      "label": "{{t.volume}}",
      "value": "{{state.volumeText}}"
    },
    {
      "type": "spacer"
    },
    {
      "type": "when",
      "condition": "state.isMuted",
      "then": {
        "type": "badge",
        "text": "{{t.muted}}",
        "tone": "warning"
      }
    },
    {
      "type": "when",
      "condition": "state.isMuted",
      "then": {
        "type": "button",
        "title": "{{t.unmute}}",
        "action": "toggleMute",
        "symbol": "speaker.wave.2"
      }
    },
    {
      "type": "when",
      "condition": "state.notMuted",
      "then": {
        "type": "button",
        "title": "{{t.mute}}",
        "action": "toggleMute",
        "symbol": "speaker.slash"
      }
    }
  ]
}
