{
  "type": "vstack",
  "children": [
    {
      "type": "text",
      "text": "{{t.rows}}",
      "style": "caption"
    },
    {
      "type": "stepper",
      "key": "maximumRows",
      "min": 3,
      "max": 20,
      "step": 1
    },
    {
      "type": "text",
      "text": "{{t.refreshInterval}}",
      "style": "caption"
    },
    {
      "type": "picker",
      "key": "refreshIntervalSeconds",
      "options": "5,10,30,60",
      "style": "segmented"
    },
    {
      "type": "button",
      "title": "{{t.settings}}",
      "action": "openSettings",
      "symbol": "gearshape"
    }
  ],
  "spacing": 10
}
