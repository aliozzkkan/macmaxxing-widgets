{
  "type": "vstack",
  "children": [
    {
      "type": "hstack",
      "children": [
        {
          "type": "text",
          "text": "{{t.subtitle}}",
          "style": "caption"
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isRunning",
          "then": {
            "type": "badge",
            "text": "{{t.running}}",
            "tone": "accent"
          }
        },
        {
          "type": "when",
          "condition": "state.isOk",
          "then": {
            "type": "badge",
            "text": "{{t.upToDate}}",
            "tone": "positive"
          }
        },
        {
          "type": "when",
          "condition": "state.isNone",
          "then": {
            "type": "badge",
            "text": "{{t.noBackup}}",
            "tone": "warning"
          }
        }
      ],
      "spacing": 8
    },
    {
      "type": "hstack",
      "children": [
        {
          "type": "vstack",
          "children": [
            {
              "type": "when",
              "condition": "state.isRunning",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{state.summary}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{t.runningBody}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            },
            {
              "type": "when",
              "condition": "state.isOk",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{state.summary}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{state.caption}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            },
            {
              "type": "when",
              "condition": "state.isNone",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{t.noBackup}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{t.noBackupBody}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            }
          ]
        },
        {
          "type": "spacer"
        }
      ],
      "spacing": 14
    },
    {
      "type": "when",
      "condition": "state.hasProgress",
      "then": {
        "type": "progress",
        "value": "state.progress",
        "label": "{{t.running}}"
      }
    },
    {
      "type": "hstack",
      "children": [
        {
          "type": "vstack",
          "children": [
            {
              "type": "when",
              "condition": "state.hasLast",
              "then": {
                "type": "value",
                "label": "{{t.lastBackup}}",
                "value": "{{state.lastBackupText}}"
              }
            },
            {
              "type": "when",
              "condition": "state.hasDestination",
              "then": {
                "type": "value",
                "label": "{{t.destination}}",
                "value": "{{state.destination}}"
              }
            }
          ],
          "spacing": 10
        },
        {
          "type": "vstack",
          "children": [
            {
              "type": "when",
              "condition": "state.hasNext",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{t.nextBackup}}",
                    "style": "caption"
                  },
                  {
                    "type": "countdown",
                    "until": "state.nextBackup",
                    "style": "value"
                  }
                ],
                "spacing": 2
              }
            },
            {
              "type": "value",
              "label": "{{t.status}}",
              "value": "{{state.statusText}}"
            }
          ],
          "spacing": 10
        }
      ],
      "spacing": 18
    },
    {
      "type": "spacer"
    },
    {
      "type": "button",
      "title": "{{t.openSettings}}",
      "action": "openSettings",
      "symbol": "gearshape"
    }
  ],
  "spacing": 12
}
