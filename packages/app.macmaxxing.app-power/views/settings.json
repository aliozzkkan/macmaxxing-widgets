{
  "type": "vstack",
  "spacing": 10,
  "children": [
    {
      "type": "text",
      "text": "{{t.rows}}",
      "style": "caption"
    },
    {
      "type": "stepper",
      "key": "maximumRows",
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "type": "text",
      "text": "{{t.density}}",
      "style": "caption"
    },
    {
      "type": "picker",
      "key": "density",
      "options": "compact,comfortable,detailed",
      "style": "segmented"
    }
  ]
}
