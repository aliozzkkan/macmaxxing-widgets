{
  "type": "dropTarget",
  "accepts": [
    "file",
    "url",
    "text"
  ],
  "action": "dropped",
  "child": {
    "type": "hstack",
    "children": [
      {
        "type": "vstack",
        "children": [
          {
            "type": "text",
            "text": "{{state.latest}}",
            "style": "body"
          },
          {
            "type": "text",
            "text": "{{t.drop}}",
            "style": "caption"
          }
        ],
        "spacing": 2
      },
      {
        "type": "spacer"
      },
      {
        "type": "value",
        "label": "{{t.items}}",
        "value": "{{state.count}}"
      }
    ],
    "spacing": 8
  }
}
