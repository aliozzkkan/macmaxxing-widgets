{
  "type": "vstack",
  "children": [
    {
      "type": "when",
      "condition": "state.hasTrack",
      "then": {
        "type": "hstack",
        "children": [
          {
            "type": "image",
            "handle": "{{state.artwork}}",
            "fallbackSymbol": "music.note",
            "shape": "rounded"
          },
          {
            "type": "vstack",
            "children": [
              {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{state.title}}",
                    "style": "body"
                  },
                  {
                    "type": "text",
                    "text": "{{state.subtitle}}",
                    "style": "caption"
                  }
                ],
                "spacing": 2
              },
              {
                "type": "when",
                "condition": "state.canSeek",
                "then": {
                  "type": "scrubber",
                  "elapsed": "state.elapsed",
                  "duration": "state.duration",
                  "rate": "state.rate",
                  "at": "state.at",
                  "action": "seek"
                }
              },
              {
                "type": "mediaTransport",
                "state": "state.playing",
                "actions": {
                  "playPause": "playPause",
                  "next": "next",
                  "previous": "previous"
                }
              }
            ],
            "spacing": 6
          }
        ],
        "spacing": 12
      }
    },
    {
      "type": "when",
      "condition": "state.isIdle",
      "then": {
        "type": "vstack",
        "children": [
          {
            "type": "symbol",
            "name": "music.note"
          },
          {
            "type": "text",
            "text": "{{t.idle}}",
            "style": "body"
          }
        ],
        "spacing": 4
      }
    }
  ],
  "spacing": 4
}
