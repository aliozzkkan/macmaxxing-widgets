{
  "type": "vstack",
  "children": [
    {
      "type": "when",
      "condition": "state.hasTrack",
      "then": {
        "type": "hstack",
        "children": [
          {
            "type": "image",
            "handle": "{{state.artwork}}",
            "fallbackSymbol": "music.note",
            "shape": "rounded"
          },
          {
            "type": "vstack",
            "children": [
              {
                "type": "text",
                "text": "{{state.title}}",
                "style": "body"
              },
              {
                "type": "text",
                "text": "{{state.subtitle}}",
                "style": "caption"
              }
            ],
            "spacing": 2
          },
          {
            "type": "spacer"
          },
          {
            "type": "mediaTransport",
            "state": "state.playing",
            "actions": {
              "playPause": "playPause"
            }
          }
        ],
        "spacing": 8
      }
    },
    {
      "type": "when",
      "condition": "state.isIdle",
      "then": {
        "type": "hstack",
        "children": [
          {
            "type": "symbol",
            "name": "music.note"
          },
          {
            "type": "text",
            "text": "{{t.idle}}",
            "style": "body"
          }
        ],
        "spacing": 8
      }
    }
  ],
  "spacing": 4
}
