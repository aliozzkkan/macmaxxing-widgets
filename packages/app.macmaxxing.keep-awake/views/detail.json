{
  "type": "vstack",
  "spacing": 12,
  "children": [
    {
      "type": "hstack",
      "spacing": 8,
      "children": [
        {
          "type": "text",
          "text": "{{t.subtitle}}",
          "style": "caption"
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isActive",
          "then": {
            "type": "badge",
            "text": "{{t.awake}}",
            "tone": "positive"
          }
        },
        {
          "type": "when",
          "condition": "state.isIdle",
          "then": {
            "type": "badge",
            "text": "{{t.off}}",
            "tone": "neutral"
          }
        }
      ]
    },
    {
      "type": "hstack",
      "spacing": 14,
      "children": [
        {
          "type": "vstack",
          "spacing": 3,
          "children": [
            {
              "type": "when",
              "condition": "state.isActive",
              "then": {
                "type": "text",
                "text": "{{t.awake}}",
                "style": "title"
              }
            },
            {
              "type": "when",
              "condition": "state.isIdle",
              "then": {
                "type": "text",
                "text": "{{t.off}}",
                "style": "title"
              }
            },
            {
              "type": "when",
              "condition": "state.isTimed",
              "then": {
                "type": "countdown",
                "until": "state.endsAt",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isIndefinite",
              "then": {
                "type": "text",
                "text": "{{t.indef}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isActive",
              "then": {
                "type": "text",
                "text": "{{t.awakeNote}}",
                "style": "body"
              }
            },
            {
              "type": "when",
              "condition": "state.isIdle",
              "then": {
                "type": "text",
                "text": "{{t.idleNote}}",
                "style": "body"
              }
            }
          ]
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isIdle",
          "then": {
            "type": "button",
            "title": "{{t.start}}",
            "action": "start15",
            "symbol": "play.fill"
          }
        },
        {
          "type": "when",
          "condition": "state.isActive",
          "then": {
            "type": "button",
            "title": "{{t.stop}}",
            "action": "stop",
            "symbol": "stop.fill"
          }
        }
      ]
    },
    {
      "type": "text",
      "text": "{{t.plan}}",
      "style": "caption"
    },
    {
      "type": "hstack",
      "spacing": 6,
      "children": [
        {
          "type": "button",
          "title": "{{t.m15}}",
          "action": "start15"
        },
        {
          "type": "button",
          "title": "{{t.m30}}",
          "action": "start30"
        },
        {
          "type": "button",
          "title": "{{t.h1}}",
          "action": "start60"
        },
        {
          "type": "button",
          "title": "{{t.indef}}",
          "action": "startIndefinite"
        }
      ]
    },
    {
      "type": "when",
      "condition": "state.isTimed",
      "then": {
        "type": "hstack",
        "spacing": 6,
        "children": [
          {
            "type": "button",
            "title": "−15 {{t.minuteShort}}",
            "action": "minus15"
          },
          {
            "type": "button",
            "title": "+15 {{t.minuteShort}}",
            "action": "plus15"
          }
        ]
      }
    },
    {
      "type": "text",
      "text": "{{t.protection}}",
      "style": "caption"
    },
    {
      "type": "toggle",
      "title": "{{t.display}}",
      "key": "allowsDisplaySleep"
    },
    {
      "type": "toggle",
      "title": "{{t.lid}}",
      "key": "keepsAwakeWithLidClosed"
    },
    {
      "type": "toggle",
      "title": "{{t.notifications}}",
      "key": "notificationsEnabled"
    },
    {
      "type": "toggle",
      "title": "{{t.lowBattery}}",
      "key": "lowBatteryProtection"
    },
    {
      "type": "stepper",
      "key": "lowBatteryThreshold",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%"
    }
  ]
}
