{
  "type": "dropTarget",
  "accepts": [
    "file",
    "url",
    "text",
    "image"
  ],
  "action": "dropped",
  "child": {
    "type": "hstack",
    "children": [
      {
        "type": "vstack",
        "children": [
          {
            "type": "when",
            "condition": "state.isLocked",
            "then": {
              "type": "symbol",
              "name": "lock.fill"
            }
          },
          {
            "type": "when",
            "condition": "state.isUnlocked",
            "then": {
              "type": "symbol",
              "name": "lock.open.fill"
            }
          }
        ],
        "spacing": 0
      },
      {
        "type": "vstack",
        "children": [
          {
            "type": "when",
            "condition": "state.isLocked",
            "then": {
              "type": "text",
              "text": "{{t.locked}}",
              "style": "body"
            }
          },
          {
            "type": "when",
            "condition": "state.isUnlocked",
            "then": {
              "type": "hstack",
              "children": [
                {
                  "type": "text",
                  "text": "{{state.itemCount}}",
                  "style": "body"
                },
                {
                  "type": "text",
                  "text": "{{t.shelf}}",
                  "style": "body"
                }
              ],
              "spacing": 4
            }
          }
        ],
        "spacing": 0
      },
      {
        "type": "spacer"
      }
    ],
    "spacing": 8
  }
}
