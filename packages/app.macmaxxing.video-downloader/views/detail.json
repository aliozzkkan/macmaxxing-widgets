{
  "type": "dropTarget",
  "accepts": [
    "url",
    "text"
  ],
  "action": "dropped",
  "child": {
    "type": "vstack",
    "children": [
      {
        "type": "hstack",
        "children": [
          {
            "type": "symbol",
            "name": "arrow.down.circle.fill"
          },
          {
            "type": "text",
            "text": "{{t.title}}",
            "style": "title"
          },
          {
            "type": "spacer"
          },
          {
            "type": "when",
            "condition": "state.isDownloading",
            "then": {
              "type": "badge",
              "text": "{{state.progress}}%",
              "tone": "accent"
            }
          },
          {
            "type": "when",
            "condition": "state.isFinished",
            "then": {
              "type": "badge",
              "text": "{{t.finished}}",
              "tone": "positive"
            }
          },
          {
            "type": "when",
            "condition": "state.isFailed",
            "then": {
              "type": "badge",
              "text": "{{t.failed}}",
              "tone": "critical"
            }
          }
        ],
        "spacing": 8
      },
      {
        "type": "vstack",
        "children": [
          {
            "type": "when",
            "condition": "state.isIdle",
            "then": {
              "type": "text",
              "text": "{{t.drop}}",
              "style": "body"
            }
          },
          {
            "type": "when",
            "condition": "state.isPreparing",
            "then": {
              "type": "text",
              "text": "{{t.preparing}}",
              "style": "body"
            }
          },
          {
            "type": "when",
            "condition": "state.isDownloading",
            "then": {
              "type": "text",
              "text": "{{state.message}}",
              "style": "body"
            }
          },
          {
            "type": "when",
            "condition": "state.isFinished",
            "then": {
              "type": "text",
              "text": "{{t.finished}}",
              "style": "body"
            }
          },
          {
            "type": "when",
            "condition": "state.isFailed",
            "then": {
              "type": "text",
              "text": "{{t.failed}}",
              "style": "body"
            }
          },
          {
            "type": "when",
            "condition": "state.isCancelled",
            "then": {
              "type": "text",
              "text": "{{t.cancelled}}",
              "style": "body"
            }
          }
        ],
        "spacing": 0
      },
      {
        "type": "when",
        "condition": "state.isIdle",
        "then": {
          "type": "text",
          "text": "{{t.hint}}",
          "style": "caption"
        }
      },
      {
        "type": "when",
        "condition": "state.isDownloading",
        "then": {
          "type": "progress",
          "value": "state.progress",
          "label": "{{state.progress}}%"
        }
      },
      {
        "type": "when",
        "condition": "state.hasTitle",
        "then": {
          "type": "text",
          "text": "{{state.title}}",
          "style": "body"
        }
      },
      {
        "type": "when",
        "condition": "state.isFailed",
        "then": {
          "type": "text",
          "text": "{{state.message}}",
          "style": "caption"
        }
      },
      {
        "type": "spacer"
      },
      {
        "type": "vstack",
        "children": [
          {
            "type": "when",
            "condition": "state.canStart",
            "then": {
              "type": "button",
              "title": "{{t.paste}}",
              "action": "paste",
              "symbol": "doc.on.clipboard"
            }
          },
          {
            "type": "when",
            "condition": "state.isBusy",
            "then": {
              "type": "button",
              "title": "{{t.cancel}}",
              "action": "cancel",
              "symbol": "xmark.circle"
            }
          },
          {
            "type": "when",
            "condition": "state.isFinished",
            "then": {
              "type": "button",
              "title": "{{t.reveal}}",
              "action": "reveal",
              "symbol": "folder"
            }
          }
        ],
        "spacing": 6
      }
    ],
    "spacing": 12
  }
}
