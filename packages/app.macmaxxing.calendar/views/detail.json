{
  "type": "vstack",
  "children": [
    {
      "type": "hstack",
      "children": [
        {
          "type": "text",
          "text": "{{t.subtitle}}",
          "style": "caption"
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.needsAccess",
          "then": {
            "type": "badge",
            "text": "{{t.permission}}",
            "tone": "warning"
          }
        },
        {
          "type": "when",
          "condition": "state.isDenied",
          "then": {
            "type": "badge",
            "text": "{{t.permission}}",
            "tone": "warning"
          }
        }
      ],
      "spacing": 8
    },
    {
      "type": "hstack",
      "children": [
        {
          "type": "vstack",
          "children": [
            {
              "type": "when",
              "condition": "state.isReady",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{state.summary}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{state.caption}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            },
            {
              "type": "when",
              "condition": "state.isEmpty",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{t.noEvents}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{t.noEventsBody}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            },
            {
              "type": "when",
              "condition": "state.needsAccess",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{t.needsAccess}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{t.needsAccessHint}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            },
            {
              "type": "when",
              "condition": "state.isDenied",
              "then": {
                "type": "vstack",
                "children": [
                  {
                    "type": "text",
                    "text": "{{t.needsAccess}}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{t.deniedHint}}",
                    "style": "body"
                  }
                ],
                "spacing": 3
              }
            }
          ]
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isReady",
          "then": {
            "type": "value",
            "label": "{{t.today}}",
            "value": "{{state.count}}"
          }
        }
      ],
      "spacing": 14
    },
    {
      "type": "hstack",
      "children": [
        {
          "type": "vstack",
          "children": [
            {
              "type": "text",
              "text": "{{t.chartTitle}}",
              "style": "body"
            },
            {
              "type": "chart",
              "kind": "bar",
              "series": "state.busyChart",
              "isLive": true,
              "accessibilityLabel": "{{t.chartAccessibility}}"
            },
            {
              "type": "text",
              "text": "{{t.chartNote}}",
              "style": "caption"
            }
          ],
          "spacing": 6
        },
        {
          "type": "vstack",
          "children": [
            {
              "type": "text",
              "text": "{{t.eventsTitle}}",
              "style": "body"
            },
            {
              "type": "rows",
              "items": "state.rows",
              "title": "title",
              "value": "value"
            },
            {
              "type": "spacer"
            }
          ],
          "spacing": 6
        }
      ],
      "spacing": 18
    },
    {
      "type": "when",
      "condition": "state.needsAccess",
      "then": {
        "type": "button",
        "title": "{{t.grantAccess}}",
        "action": "requestAccess",
        "symbol": "calendar"
      }
    }
  ],
  "spacing": 12
}
