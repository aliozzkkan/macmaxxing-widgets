{
  "type": "vstack",
  "children": [
    {
      "type": "text",
      "text": "{{t.maximumRows}}",
      "style": "caption"
    },
    {
      "type": "stepper",
      "key": "maximumRows",
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "type": "text",
      "text": "{{t.refreshInterval}}",
      "style": "caption"
    },
    {
      "type": "picker",
      "key": "refreshIntervalSeconds",
      "options": "5,10,30,60",
      "style": "segmented"
    }
  ],
  "spacing": 10
}
