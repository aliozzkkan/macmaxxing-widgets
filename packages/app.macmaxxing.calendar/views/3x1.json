{
  "type": "vstack",
  "children": [
    {
      "type": "spacer"
    },
    {
      "type": "hstack",
      "children": [
        {
          "type": "vstack",
          "children": [
            {
              "type": "when",
              "condition": "state.isReady",
              "then": {
                "type": "text",
                "text": "{{state.summary}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isEmpty",
              "then": {
                "type": "text",
                "text": "{{t.noEvents}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.needsAccess",
              "then": {
                "type": "text",
                "text": "{{t.needsAccess}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isDenied",
              "then": {
                "type": "text",
                "text": "{{t.needsAccess}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isReady",
              "then": {
                "type": "text",
                "text": "{{state.caption}}",
                "style": "caption"
              }
            },
            {
              "type": "when",
              "condition": "state.needsAccess",
              "then": {
                "type": "text",
                "text": "{{t.needsAccessHint}}",
                "style": "caption"
              }
            },
            {
              "type": "when",
              "condition": "state.isDenied",
              "then": {
                "type": "text",
                "text": "{{t.deniedHint}}",
                "style": "caption"
              }
            }
          ],
          "spacing": 1
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.isReady",
          "then": {
            "type": "value",
            "label": "{{t.today}}",
            "value": "{{state.count}}"
          }
        }
      ],
      "spacing": 8
    },
    {
      "type": "spacer"
    }
  ],
  "spacing": 0
}
