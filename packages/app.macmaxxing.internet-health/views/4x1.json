{
  "type": "vstack",
  "children": [
    {
      "type": "spacer"
    },
    {
      "type": "hstack",
      "children": [
        {
          "type": "vstack",
          "children": [
            {
              "type": "when",
              "condition": "state.isTesting",
              "then": {
                "type": "text",
                "text": "{{state.headline}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isOnline",
              "then": {
                "type": "text",
                "text": "{{state.headline}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isOffline",
              "then": {
                "type": "text",
                "text": "{{t.offline}}",
                "style": "value"
              }
            },
            {
              "type": "when",
              "condition": "state.isTesting",
              "then": {
                "type": "text",
                "text": "{{t.testing}}",
                "style": "caption"
              }
            },
            {
              "type": "when",
              "condition": "state.isOnline",
              "then": {
                "type": "text",
                "text": "{{state.statusText}}",
                "style": "caption"
              }
            },
            {
              "type": "when",
              "condition": "state.isOffline",
              "then": {
                "type": "text",
                "text": "{{t.offlineBody}}",
                "style": "caption"
              }
            }
          ],
          "spacing": 1
        },
        {
          "type": "spacer"
        },
        {
          "type": "when",
          "condition": "state.canTest",
          "then": {
            "type": "button",
            "title": "{{t.speedTest}}",
            "action": "startSpeedTest",
            "symbol": "speedometer"
          }
        }
      ],
      "spacing": 8
    },
    {
      "type": "spacer"
    }
  ],
  "spacing": 0
}
