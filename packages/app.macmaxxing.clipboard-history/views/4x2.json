{
  "type": "hstack",
  "children": [
    {
      "type": "vstack",
      "children": [
        {
          "type": "list",
          "items": "state.items",
          "id": "id",
          "title": "title",
          "detail": "detail",
          "symbol": "sym",
          "image": "image",
          "action": "copy",
          "menu": [
            {
              "title": "{{t.copy}}",
              "action": "copy",
              "symbol": "doc.on.doc"
            },
            {
              "title": "{{t.copyClean}}",
              "action": "copyClean",
              "symbol": "link"
            },
            {
              "title": "{{t.pin}}",
              "action": "pin",
              "symbol": "pin"
            },
            {
              "title": "{{t.paste}}",
              "action": "paste",
              "symbol": "text.badge.checkmark"
            }
          ],
          "emptyText": "{{t.empty}}"
        }
      ],
      "spacing": 6
    },
    {
      "type": "vstack",
      "children": [
        {
          "type": "value",
          "label": "{{t.items}}",
          "value": "{{state.count}}"
        },
        {
          "type": "text",
          "text": "{{t.latest}}",
          "style": "caption"
        },
        {
          "type": "text",
          "text": "{{state.latest}}",
          "style": "body"
        }
      ],
      "spacing": 3
    }
  ],
  "spacing": 10
}
